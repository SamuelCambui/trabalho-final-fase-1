ACCESS_TOKEN_EXPIRE_MINUTES=30
# Copy to .env; exported environment variables take precedence.
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_ADMIN_USERNAME=admin
API_ADMIN_PASSWORD=
API_USER_USERNAME=user
API_USER_PASSWORD=
LOG_LEVEL=INFO
MODEL_PATH=notebooks/models/champion_model.joblib
PREDICTION_THRESHOLD=0.5
PROBABILITY_DECIMALS=4
DATA_DIR=data/raw
MODELS_DIR=models
TARGET_COLUMN=Churn
ID_COLUMN=customerID
RANDOM_STATE=42
TEST_SIZE=0.3
CV_FOLDS=5
SCORING=roc_auc
MLFLOW_EXPERIMENT_NAME=churn-prediction-cicd
MODEL_REGISTRY_NAME=churn-model
PRIMARY_METRIC=roc_auc
MIN_ACCEPTABLE_METRIC=0.60
# Optional: remote tracking URI; otherwise local storage is used.
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_TRACKING_FOLDER=mlruns_local
# Optional JSON hyperparameter grids:
# RF_PARAM_GRID={"classifier__n_estimators":[100,200,300],"classifier__max_depth":[null,10,20],"classifier__min_samples_split":[2,5,10]}
# MLP_PARAM_GRID={"classifier__hidden_layer_sizes":[[50],[100],[64,32]],"classifier__activation":["relu","tanh"],"classifier__alpha":[0.0001,0.001,0.01]}
API_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

KAGGLE_DATASET=blastchar/telco-customer-churn
# Optional Kaggle credentials (never commit real values):
# KAGGLE_USERNAME=
# KAGGLE_KEY=
# KAGGLE_JSON={"username":"","key":""}

# Explicitly opt into the existing local MLflow filesystem backend.
MLFLOW_ALLOW_FILE_STORE=true
